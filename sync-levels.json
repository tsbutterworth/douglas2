{
  "id": "164d9152-157b-4bbd-bbdc-0a784ae69318",
  "name": "sync-levels",
  "entryPoint": "/hooks/sync-levels.js",
  "points": {
    "layer": "hpl:douglas",
    "groups": ["douglas/outputId"]
  },
  "groupVariables": [
    {
      "label": "levelSetpoint",
      "attrs": {
        "douglas/outputId": "{{ Point.Attrs.douglas/outputId }}",
        "douglas/fastId": "{{ Point.Attrs.douglas/fastId }}",
        "douglas/lcuNum": "{{ Point.Attrs.douglas/lcuNum }}",
        "units": "percent"
      },
      "default_value": {
        "real": -1
      }
    }
  ],
  "mode": "MODE_ON_DATA",
  "invokeTimeout": "30s"
}
